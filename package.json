{
  "name": "prooflens-ai",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=prooflens-web",
    "build:web": "npm run build --workspace=prooflens-web",
    "lint": "npm run lint --workspace=prooflens-web",
    "test:backend": "cd backend && python -m pytest",
    "test:e2e": "npm run test:e2e --workspace=prooflens-web",
    "mobile": "cd 'Mobile APP' && npm run start",
    "mobile:ios": "cd 'Mobile APP' && npm run ios",
    "mobile:android": "cd 'Mobile APP' && npm run android",
    "clamav:up": "docker compose -f docker-compose.clamav.yml up -d",
    "clamav:down": "docker compose -f docker-compose.clamav.yml down",
    "clamav:logs": "docker compose -f docker-compose.clamav.yml logs -f clamav",
    "clamav:host-install": "bash scripts/install-clamav-macos.sh"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=25.0.0"
  }
}
